{
  "name": "Free PDF Safe",
  "short_name": "PDF Safe",
  "description": "Convert photos and docs to PDF, stamp a signature, and scan QR codes — privately on this device.",
  "id": "https://freepdfsafe.online/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#eef2f7",
  "theme_color": "#eef2f7",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "online.freepdfsafe.app"
    }
  ],
  "prefer_related_applications": false
}
